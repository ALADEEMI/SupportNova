# Copy to .env and fill in real values. Never commit .env (it is git-ignored).
# All other settings (model id, temperature, thresholds, SLA, ...) live in the database
# and are edited from Admin -> Configuration (config/seed/settings.yaml holds the defaults).

# GenAI gateway (OpenAI-compatible, ADR-007)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Database: SQLite for local development, PostgreSQL in deployment (ADR-002)
# e.g. sqlite:///storage/supportnova.db  or  postgresql+psycopg://user:password@host:5432/supportnova
DATABASE_URL=

# Session signing secret (long random string)
APP_SECRET_KEY=

# Initial passwords for seeded demo users (P01-S5, ADR-014)
SEED_PASSWORD_ADMIN=
SEED_PASSWORD_EVALUATOR=
SEED_PASSWORD_MANAGER=
SEED_PASSWORD_REVIEWER=
SEED_PASSWORD_AGENT=
SEED_PASSWORD_CUSTOMER=
